{
    "name": "zaruto/bml-connect-php",
    "description": "PHP Bindings for the BML Connect API",
    "keywords": [
        "bml",
        "bankofmaldives",
        "pay",
        "alipay",
        "php",
        "api",
        "maldives",
        "card payments"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Simon Verraest",
            "email": "simon@pomelopay.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.2",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "BMLConnect\\": [
                "src"
            ]
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:cs",
            "@test:stan"
        ],
        "test:unit": "./vendor/bin/phpunit -c ./phpunit.xml",
        "test:cs": "./vendor/bin/phpcs --standard=PSR12 ./src",
        "test:stan": "./vendor/bin/phpstan analyse --level=max ./src"
    }
}
